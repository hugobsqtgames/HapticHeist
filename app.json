{
  "expo": {
    "name": "Haptic Heist",
    "slug": "haptic-heist",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hugobsqtgames.hapticheist"
    },
    "android": {
      "package": "com.hugobsqtgames.hapticheist",
      "edgeToEdgeEnabled": true
    },
    "scheme": "hapticheist",
    "plugins": [
      "expo-router"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
